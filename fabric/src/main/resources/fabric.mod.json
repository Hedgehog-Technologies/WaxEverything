{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "${homepage_url}",
        "sources": "${source_url}",
        "issues": "${issue_url}"
    },
    "license": "${license}",
    "icon": "assets/waxeverything/textures/gui/${mod_id}.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "org.hedgetech.waxeverything.FabricWaxEverything"
        ],
        "client": [
            "org.hedgetech.waxeverything.FabricClientWaxEverything"
        ],
        "modmenu": [
            "org.hedgetech.waxeverything.ui.FabricConfigUI"
        ]
    },
    "mixins": [
      "${mod_id}.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "~${minecraft_version}",
        "java": ">=${java_version}"
    },
    "suggests": {
        "yet_another_config_lib_v3": ">=${yacl_version}",
        "modmenu": ">=${modmenu_version}"
    }
}
  